---
layout: base.njk
permalink: /certifications/index.html
pageTitle: "Certifications & Professional Learning | Daramola Joseph Omoyele"
pageDescription: "Professional certifications and continuing education completed by Daramola Joseph Omoyele."
breadcrumbLabel: "Certifications"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Certifications</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Professional Learning</span>
            <h1>Certifications &amp; Professional Learning</h1>
            <p class="pc-hero-sub">Continuing professional development across data analytics, SQL, and business intelligence tools, each independently verified.</p>
        </header>

        <div class="certlearn-grid">
            {% for item in collections.certifications | reverse %}
            <div class="certlearn-card reveal">
                <h3>{{ item.data.title }}</h3>
                <p class="certlearn-provider">{{ item.data.provider }}</p>
                {% if item.data.date_display %}<p class="certlearn-date">Completed {{ item.data.date_display }}</p>{% endif %}
                {% if item.data.cert_no %}<p class="certlearn-no">Certificate No: {{ item.data.cert_no }}</p>{% endif %}
                <p class="certlearn-relevance">{{ item.data.relevance }}</p>
                <div class="policy-tags">
                    {% for tag in item.data.tags %}<span class="policy-tag">{{ tag }}</span>{% endfor %}
                </div>
                {% if item.data.verify %}
                <a href="{{ item.data.verify }}" target="_blank" rel="noopener" class="btn btn-soft btn-sm certlearn-btn">Verify Certificate</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/expertise/"><span class="fpc-outlet">Technical Expertise</span><span class="fpc-headline">Core Expertise</span><span class="fpc-go">View section →</span></a>
                <a class="fpc-card" href="/education/"><span class="fpc-outlet">Academic Background</span><span class="fpc-headline">Education</span><span class="fpc-go">View section →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-outlet">Get in touch</span><span class="fpc-headline">Contact Me</span><span class="fpc-go">View section →</span></a>
            </div>
        </section>
    </div>
</main>
