    <!-- ===================== 4. RESEARCH & POLICY CONTRIBUTIONS ===================== -->
    <section id="research-policy" class="section">
        <div class="container">
            <!-- Featured Policy Highlight preview -->
            <div style="margin-bottom:2.5rem;">
                <a class="fpc-preview" href="/policy-contributions/">
