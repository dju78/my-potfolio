---
layout: base.njk
permalink: /books/index.html
pageTitle: "Books & Handbooks | Daramola Joseph Omoyele"
pageDescription: "Books and handbooks written by Daramola Joseph Omoyele."
breadcrumbLabel: "Books"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Books</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Thought Leadership</span>
            <h1>Books &amp; Handbooks</h1>
            <p class="pc-hero-sub">Independently published books and handbooks distilling applied economics, tax compliance, and data analysis for practitioners.</p>
        </header>

        <div class="publications-grid">
            {% for book in collections.books | reverse %}
            <div class="publication-card book-card flip-card reveal" tabindex="0" role="region" aria-label="{{ book.data.title }}">
                <div class="flip-card-inner">
                    <div class="flip-card-front">
                        <img src="{{ book.data.image }}" alt="{{ book.data.title }} Cover" class="book-cover-img" loading="lazy"/>
                        <div class="flip-hint">Click or hover to read details</div>
                        <button class="btn btn-sm btn-soft book-flip-btn" type="button" aria-label="View details for {{ book.data.title }}" style="position:absolute; bottom:1rem; left:50%; transform:translateX(-50%); z-index:2;">View Details</button>
                    </div>
                    <div class="flip-card-back">
                        <h3>{{ book.data.title }}</h3>
                        {% if book.data.subtitle %}<p class="pub-subtitle"><em>{{ book.data.subtitle }}</em></p>{% endif %}
                        <p class="pub-meta">Independently published ({{ book.data.year }})</p>
                        {% if book.data.isbn %}<p class="pub-isbn">ISBN: {{ book.data.isbn }}</p>{% endif %}
                        {% if book.data.asin %}<p class="pub-isbn">ASIN: {{ book.data.asin }}</p>{% endif %}
                        <div class="pub-description">{{ book.templateContent | safe }}</div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:auto; padding-top:0.5rem; border-top:1px solid var(--border);">
                            <a href="{{ book.data.link }}" target="_blank" rel="noopener" class="pub-link" style="border:none; padding:0; margin:0;">View on Amazon →</a>
                            <button class="book-flip-back-btn" type="button" style="background:none; border:none; color:var(--text-3); font-size:0.8rem; cursor:pointer; font-weight:600;">Close âœ•</button>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/publications/"><span class="fpc-headline">Published Journal Articles</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/working-papers/"><span class="fpc-headline">Working Papers &amp; Preprints</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-headline">Contact Me</span><span class="fpc-go">View page →</span></a>
            </div>
        </section>
    </div>
</main>
