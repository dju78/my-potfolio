---
layout: base.njk
permalink: /research-visibility/index.html
pageTitle: "External Mentions & Research Visibility | Daramola Joseph Omoyele"
pageDescription: "External mentions and research visibility for Daramola Joseph Omoyele's published work."
breadcrumbLabel: "Research Visibility"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Research Visibility</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Research Visibility</span>
            <h1>External Mentions &amp; Research Visibility</h1>
            <p class="pc-hero-sub">Independent research picked up in third-party roundups and reviews, including the TaxProf Blog SSRN Tax Roundup.</p>
        </header>

        <div class="mentions-grid">
            {% for item in collections.external_mentions | reverse %}
            <div class="mention-card reveal">
                <div class="mention-meta">
                    <span class="mention-type">{{ item.data.mention_type }}</span>
                    {% if item.data.date_display %}<span class="mention-date">{{ item.data.date_display }}</span>{% endif %}
                </div>
                <h3>{{ item.data.title }}</h3>
                {% if item.data.source %}<p class="mention-source"><strong>Source:</strong> {{ item.data.source }}</p>{% endif %}
                <p class="mention-desc">{{ item.data.description }}</p>
                {% if item.data.papers %}
                <div class="mention-papers">
                    <span class="mention-papers-label">Papers mentioned:</span>
                    <ul>{% for p in item.data.papers %}<li>{{ p }}</li>{% endfor %}</ul>
                </div>
                {% endif %}
                <div class="policy-tags">
                    {% for tag in item.data.tags %}<span class="policy-tag">{{ tag }}</span>{% endfor %}
                </div>
                {% if item.data.link %}
                <a href="{{ item.data.link }}" target="_blank" rel="noopener" class="btn btn-soft btn-sm mention-btn">{{ item.data.button_text or "View Mention" }}</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/publications/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">Published Journal Articles</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/working-papers/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">Working Papers &amp; Preprints</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-outlet">Get in touch</span><span class="fpc-headline">Contact Me</span><span class="fpc-go">View page →</span></a>
            </div>
        </section>
    </div>
</main>
