<!DOCTYPE html>
<html lang="en-GB" class="no-js">

<head>
    <meta charset="UTF-8">
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle or "Daramola Joseph Omoyele, Research and Data Analyst" }}</title>
    <meta name="description" content="{{ pageDescription or 'I turn complex data into clear evidence for better decisions, combining economic research, statistical analysis and performance reporting.' }}">
    <link rel="canonical" href="https://daramolajo.co.uk{{ canonicalPath or page.url }}">
    <meta property="og:title" content="{{ pageTitle or 'Daramola Joseph Omoyele, Research and Data Analyst' }}">
    <meta property="og:description" content="{{ pageDescription or 'I turn complex data into clear evidence for better decisions, combining economic research, statistical analysis and performance reporting.' }}">
    <meta property="og:image" content="https://daramolajo.co.uk/djo-portfolio-logo.png">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="https://daramolajo.co.uk{{ page.url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle or 'Daramola Joseph Omoyele, Research and Data Analyst' }}">
    <meta name="twitter:description" content="{{ pageDescription or 'I turn complex data into clear evidence for better decisions, combining economic research, statistical analysis and performance reporting.' }}">
    <meta name="twitter:image" content="https://daramolajo.co.uk/djo-portfolio-logo.png">
    <link rel="icon" type="image/png" href="/djo-portfolio-logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Daramola Joseph Omoyele",
      "url": "https://daramolajo.co.uk/",
      "logo": "https://daramolajo.co.uk/djo-portfolio-logo.png",
      "image": "https://daramolajo.co.uk/djo-portfolio-logo.png",
      "jobTitle": "Research and Data Analyst",
      "email": "mailto:info@jomovate.com",
      "description": "I turn complex data into clear evidence for better decisions, combining economic research, statistical analysis and performance reporting.",
      "sameAs": [
        "https://github.com/dju78",
        "https://www.linkedin.com/in/joseph-omoyele-bbb006244/",
        "https://orcid.org/0009-0006-0347-0499",
        "https://jomovate.com"
      ]
    }
    </script>
</head>

<body>

    <!-- ===================== NAVBAR ===================== -->
    <header class="navbar" id="navbar">
        <div class="nav-container">
            <a href="/" class="nav-brand">Daramola Joseph Omoyele</a>
            <nav class="nav-menu" id="navMenu" aria-label="Main">
                <a href="/projects/" class="nav-link{% if page.url == '/projects/' %} active{% endif %}">Work</a>
                <div class="nav-item-dropdown">
                    <button class="nav-link nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false" data-dropdown="research">Research</button>
                    <ul class="nav-dropdown" id="research-menu" aria-label="Research submenu">
                        <li><a href="/academic-research/" class="nav-dropdown-link{% if page.url == '/academic-research/' %} active{% endif %}">Academic Research</a></li>
                        <li><a href="/publications/" class="nav-dropdown-link{% if page.url == '/publications/' %} active{% endif %}">Publications</a></li>
                        <li><a href="/books/" class="nav-dropdown-link{% if page.url == '/books/' %} active{% endif %}">Books</a></li>
                        <li><a href="/public-engagement/" class="nav-dropdown-link{% if page.url == '/public-engagement/' %} active{% endif %}">Media</a></li>
                    </ul>
                </div>
                <div class="nav-item-dropdown">
                    <button class="nav-link nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false" data-dropdown="policy">Policy</button>
                    <ul class="nav-dropdown" id="policy-menu" aria-label="Policy submenu">
                        <li><a href="/policy-contributions/" class="nav-dropdown-link{% if page.url == '/policy-contributions/' %} active{% endif %}">Policy Work</a></li>
                        <li><a href="/impact/" class="nav-dropdown-link{% if page.url == '/impact/' %} active{% endif %}">Impact</a></li>
                    </ul>
                </div>
                <a href="/experience/" class="nav-link{% if page.url == '/experience/' %} active{% endif %}">Experience</a>
                <a href="/cv/" class="nav-link{% if page.url == '/cv/' %} active{% endif %}">CV</a>
                <a href="mailto:info@jomovate.com" class="nav-cta">Contact me</a>
            </nav>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    {{ content | safe }}

    <!-- ===================== FOOTER ===================== -->
    <footer class="footer">
        <div class="footer-container">
            <p class="footer-copy">&copy; <span id="footer-year">2026</span> Daramola Joseph Omoyele</p>
            <p class="footer-location">Colchester, United Kingdom</p>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>
