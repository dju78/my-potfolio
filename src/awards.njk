---
layout: base.njk
permalink: /awards/index.html
pageTitle: "Awards & Honours | Daramola Joseph Omoyele"
pageDescription: "Awards and recognition earned by Daramola Joseph Omoyele."
breadcrumbLabel: "Awards"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Awards</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Recognition</span>
            <h1>Awards &amp; Honours</h1>
            <p class="pc-hero-sub">Recognition for contributions to data analysis, digital innovation, and public-sector service.</p>
        </header>

        <div class="awards-grid">
            {% for award in collections.awards | reverse %}
            <div class="award-card reveal">
                {% if award.data.image %}
                <div class="award-image-container">
                    <img src="{{ award.data.image }}" alt="{{ award.data.title }}" class="award-image" loading="lazy">
                </div>
                {% endif %}
                <div class="award-content">
                    {% if award.data.badge %}<span class="award-badge">{{ award.data.badge }}</span>{% endif %}
                    <h3>{{ award.data.title }}</h3>
                    <p class="award-issuer">{{ award.data.issuer }}</p>
                    <div class="award-description">{{ award.templateContent | safe }}</div>
                    {% if award.data.coverage %}
                    <div class="coverage-details">
                        <span class="coverage-label">Media Coverage:</span>
                        <div class="coverage-links">
                            {% for item in award.data.coverage %}
                            <a href="{{ item.url }}" target="_blank" rel="noopener" class="news-pill">Source {{ loop.index }}</a>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                    <div class="award-date"><span>📅 {{ award.data.date_issued }}</span></div>
                </div>
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/impact/"><span class="fpc-outlet">By the Numbers</span><span class="fpc-headline">Research Impact</span><span class="fpc-go">View section →</span></a>
                <a class="fpc-card" href="/public-engagement/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">Public Engagement &amp; Policy Commentary</span><span class="fpc-go">View section →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-outlet">Get in touch</span><span class="fpc-headline">Contact Me</span><span class="fpc-go">View section →</span></a>
            </div>
        </section>
    </div>
</main>
