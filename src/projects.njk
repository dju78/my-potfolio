---
layout: base.njk
permalink: /projects/index.html
pageTitle: "Featured Digital Projects | Daramola Joseph Omoyele"
pageDescription: "Digital products built by Daramola Joseph Omoyele under Daramola Digital Labs, spanning healthcare communication, tax compliance, and community platforms."
breadcrumbLabel: "Projects"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Projects</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Portfolio</span>
            <h1>Featured Digital Projects</h1>
            <p class="pc-hero-sub">Digital products built end-to-end under Daramola Digital Labs, spanning healthcare communication, tax compliance, and community platforms.</p>
        </header>

        <div class="project-filters">
            <button class="filter-btn active" data-filter="all">All Projects</button>
            <button class="filter-btn" data-filter="digital-product">Digital Products</button>
        </div>
        <div class="project-grid">
            {% for project in collections.projects | sort(false, false, 'data.order') %}
            <div class="project-card reveal" data-category="{{ project.data.badge | lower | replace(' ', '-') }}">
                <div class="project-card-top">
                    <div class="project-card-meta">
                        <span class="project-badge">{{ project.data.badge }}</span>
                        {% if project.data.status %}<span class="project-status-badge">{{ project.data.status }}</span>{% endif %}
                        <span class="project-client-tag">{{ project.data.client }}</span>
                    </div>
                    <h3 class="project-title">{{ project.data.title }}</h3>
                    <p class="project-desc">{{ project.data.description }}</p>
                </div>
                <div class="project-card-mid">
                    <div class="project-highlights">
                        {% for highlight in project.data.highlights %}
                        <div class="highlight-item"><span class="highlight-dot">▸</span><span>{{ highlight.text }}</span></div>
                        {% endfor %}
                    </div>
                    {% if project.data.tech %}
                    <div class="tech-tags">
                        {% for tag in project.data.tech %}<span class="tech-tag">{{ tag.tag }}</span>{% endfor %}
                    </div>
                    {% endif %}
                </div>
                <div class="project-card-foot">
                    {% if project.data.link and project.data.link != '#' %}
                    <a href="{{ project.data.link }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                        View Live Demo <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M4.5 10H15.5M15.5 10L10.5 5M15.5 10L10.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                    {% else %}
                    <span class="btn btn-disabled btn-sm">Coming Soon</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/expertise/"><span class="fpc-outlet">Skills</span><span class="fpc-headline">Core Expertise behind these products</span><span class="fpc-go">View section →</span></a>
                <a class="fpc-card" href="/experience/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">Professional Experience</span><span class="fpc-go">View section →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-outlet">Get in touch</span><span class="fpc-headline">Contact Me</span><span class="fpc-go">View section →</span></a>
            </div>
        </section>
    </div>
</main>
