---
layout: base.njk
permalink: /projects/index.html
pageTitle: "Projects & Analytical Products | Daramola Joseph Omoyele"
pageDescription: "Explore analytical applications, statistical methodologies, FinTech calculators, and digital platforms built by Daramola Joseph Omoyele."
breadcrumbLabel: "Projects"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Projects</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Portfolio</span>
            <h1>Projects &amp; Analytical Products</h1>
            <p class="pc-hero-sub">A comprehensive portfolio of interactive analytical applications, statistical methodologies, FinTech calculators, healthcare quality intelligence, and digital products built to solve real organisational challenges.</p>
        </header>

        <div class="project-filters" role="tablist" aria-label="Filter projects by category">
            <button class="filter-btn active" data-filter="all">All Projects</button>
            <button class="filter-btn" data-filter="data-analytics">Data Analytics &amp; BI</button>
            <button class="filter-btn" data-filter="economic-research">Economic Research &amp; Policy</button>
            <button class="filter-btn" data-filter="health-care">Healthcare &amp; Communication</button>
            <button class="filter-btn" data-filter="fintech">FinTech &amp; Calculation Tools</button>
            <button class="filter-btn" data-filter="business-applications">Business Applications &amp; Automation</button>
            <button class="filter-btn" data-filter="websites-platforms">Websites &amp; Community Platforms</button>
        </div>
        <div class="project-grid">
            {% for project in collections.projects | sort(false, false, 'data.order') %}
            <div class="project-card reveal" data-category="{% if project.data.categories %}{{ project.data.categories | join(' ') }}{% else %}{{ project.data.badge | lower | replace(' ', '-') }}{% endif %}">
                <div class="project-card-top">
                    <div class="project-card-meta">
                        <span class="project-badge">{{ project.data.badge }}</span>
                        {% if project.data.status %}<span class="project-status-badge">{{ project.data.status }}</span>{% endif %}
                        <span class="project-client-tag">{{ project.data.client }}</span>
                    </div>
                    <h3 class="project-title">{{ project.data.title }}</h3>
                    <p class="project-desc">{{ project.data.description }}</p>
                </div>
                {% if project.data.image %}
                <div class="project-card-image" style="padding:0 1.25rem 0.75rem 1.25rem;">
                    <img src="{{ project.data.image }}" alt="{{ project.data.title }} screenshot" style="width:100%; height:auto; border-radius:6px; border:1px solid var(--border-color); display:block;" loading="lazy">
                </div>
                {% endif %}
                <div class="project-card-mid">
                    <ul class="project-highlights">
                        {% for highlight in project.data.highlights %}
                        <li class="highlight-item"><span>{{ highlight.text }}</span></li>
                        {% endfor %}
                    </ul>
                    {% if project.data.case_study %}
                    <details class="project-case-study" style="margin:0.75rem 0; font-size:0.875rem; border:1px solid #e2e8f0; border-radius:6px; background:#f8fafc; padding:0.5rem 0.75rem;">
                        <summary style="cursor:pointer; font-weight:600; color:var(--navy); outline:none;">Analytical Case Study &amp; Methodology</summary>
                        <div style="margin-top:0.6rem; display:flex; flex-direction:column; gap:0.45rem; line-height:1.45; color:var(--text-color);">
                            <p><strong>Problem / Context:</strong> {{ project.data.case_study.problem }}</p>
                            <p><strong>My Contribution:</strong> {{ project.data.case_study.contribution }}</p>
                            <p><strong>Methods &amp; Tools:</strong> {{ project.data.case_study.methods }}</p>
                            <p><strong>Functionality:</strong> {{ project.data.case_study.functionality }}</p>
                            <p><strong>Limitations &amp; Guardrails:</strong> {{ project.data.case_study.limitations }}</p>
                        </div>
                    </details>
                    {% endif %}
                    {% if project.data.tech or project.data.tags %}
                    <div class="tech-tags">
                        {% for tag in (project.data.tech or project.data.tags) %}<span class="tech-tag">{{ tag.tag }}</span>{% endfor %}
                    </div>
                    {% endif %}
                </div>
                <div class="project-card-foot">
                    {% if project.data.status and "Restricted Access" in project.data.status %}
                    <span class="btn btn-disabled btn-sm">Preview available on request</span>
                    {% elseif project.data.link and project.data.link != '#' %}
                    <a href="{{ project.data.link }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                        View Live Demo <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M4.5 10H15.5M15.5 10L10.5 5M15.5 10L10.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                    {% else %}
                    <span class="btn btn-disabled btn-sm">{% if project.data.status %}{{ project.data.status }}{% else %}In Development{% endif %}</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/expertise/"><span class="fpc-outlet">Skills</span><span class="fpc-headline">Core Expertise behind these products</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/experience/"><span class="fpc-headline">Professional Experience</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-headline">Contact Me</span><span class="fpc-go">View page →</span></a>
            </div>
        </section>
    </div>
</main>
