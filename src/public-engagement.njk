layout: base.njk
permalink: /public-engagement/index.html
pageTitle: "Public Engagement & Policy Commentary | Daramola Joseph Omoyele"
pageDescription: "Media appearances and policy commentary by Daramola Joseph Omoyele across major Nigerian media outlets."
breadcrumbLabel: "Public Engagement"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Public Engagement</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Thought Leadership</span>
            <h1>Public Engagement &amp; Policy Commentary</h1>
            <p class="pc-hero-sub">Consistently translating economic evidence into public policy debate for wider audiences across major Nigerian media outlets.</p>
        </header>

        <div class="publications-grid">
            <div class="publication-card media-card reveal">
                <div class="pub-icon">📰</div>
                <h3>Media &amp; Policy Commentary</h3>
                <div class="media-list">
                    {% for item in collections.media | reverse %}
                    <div class="media-item">
                        <h4>{{ item.data.title }}</h4>
                        <p class="media-description">{{ item.data.description }} <span class="media-date">({{ item.data.date_issued }})</span></p>
                        <div class="coverage-details">
                            <span class="coverage-label">Published in:</span>
                            <div class="coverage-links">
                                {% for source in item.data.coverage %}
                                {% if source.url %}<a href="{{ source.url }}" target="_blank" rel="noopener" class="news-pill">{{ source.source }}</a>{% else %}<span class="news-pill news-pill-plain">{{ source.source }}</span>{% endif %}
                                {% endfor %}
                            </div>
                            {% if item.data.other_platforms %}<p class="other-coverage">{{ item.data.other_platforms }}</p>{% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <a class="fpc-xlink fpc-xlink-inline" href="/policy-contributions/">See the featured policy case study →</a>
            </div>
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/policy-contributions/"><span class="fpc-outlet">Policy Engagement</span><span class="fpc-headline">Policy Contributions &amp; Consultation Responses</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/research-visibility/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">External Mentions &amp; Research Visibility</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-outlet">Get in touch</span><span class="fpc-headline">Contact Me</span><span class="fpc-go">View page →</span></a>
            </div>
        </section>
    </div>
</main>
