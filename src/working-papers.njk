---
layout: base.njk
permalink: /working-papers/index.html
pageTitle: "Working Papers & Preprints | Daramola Joseph Omoyele"
pageDescription: "Working papers and preprints authored by Daramola Joseph Omoyele."
breadcrumbLabel: "Working Papers"
---
<main class="pc-page">
    <div class="container">
        <nav class="pc-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="pc-breadcrumb-sep">/</span>
            <span aria-current="page">Working Papers</span>
        </nav>
        <header class="pc-hero">
            <span class="section-tag">Thought Leadership</span>
            <h1>Working Papers &amp; Preprints</h1>
            <p class="pc-hero-sub">Ongoing research and preprints covering tax compliance, migration, health, and macroeconomic policy.</p>
        </header>

        <div class="publications-grid">
            {% for paper in collections.working_papers | reverse %}
            <div class="publication-card journal-card reveal">
                <div class="pub-icon">📄</div>
                <h3>{{ paper.data.title }}</h3>
                <p class="pub-meta">{{ paper.data.journal }}{% if paper.data.year %} ({{ paper.data.year }}){% endif %}</p>
                {% if paper.data.doi %}<p class="pub-doi"><a href="{{ paper.data.doi }}" target="_blank" rel="noopener">DOI Link</a></p>{% endif %}
                <p class="pub-summary">{{ paper.templateContent | excerpt(2) }}</p>
                <div class="pub-full-details collapsed">{{ paper.templateContent | safe }}</div>
                <button class="read-more-btn" aria-expanded="false">Read more ▾</button>
                {% if paper.data.contributors %}<div class="pub-contributors"><strong>Contributors:</strong> {{ paper.data.contributors }}</div>{% endif %}
                <a href="{{ paper.data.doi }}" target="_blank" rel="noopener" class="pub-link">View Preprint →</a>
            </div>
            {% endfor %}
        </div>

        <section class="pc-related">
            <h2 class="fpc-block-title">Keep exploring</h2>
            <div class="fpc-cards">
                <a class="fpc-card" href="/publications/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">Published Journal Articles</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/research-visibility/"><span class="fpc-outlet">Portfolio</span><span class="fpc-headline">External Mentions &amp; Research Visibility</span><span class="fpc-go">View page →</span></a>
                <a class="fpc-card" href="/contact/"><span class="fpc-outlet">Get in touch</span><span class="fpc-headline">Contact Me</span><span class="fpc-go">View page →</span></a>
            </div>
        </section>
    </div>
</main>
